# Copia este archivo como .env y rellena tus claves.
# El archivo .env NUNCA se sube a Git.

# API de IsThereAnyDeal (juegos: Steam)
ITAD_API_KEY=

# API de GG.deals (juegos: tiendas de claves)
GGDEALS_API_KEY=

# SerpApi (productos fisicos: Google Shopping)
SERPAPI_KEY=

# Opcional: avisos de tiendas de claves (on/off)
KEYSHOP_ALERTS=on

# Opcional: horas minimas entre consultas de un producto fisico (ahorra busquedas)
PHYSICAL_INTERVAL_HOURS=20

# Opcional: presupuesto total de Navidad en euros (aparece en el resumen semanal)
CHRISTMAS_BUDGET=

# Opcional: tus tiendas de confianza (separadas por comas). Las tiendas oficiales
# de cada marca cuentan siempre como de confianza.
# TRUSTED_SHOPS=amazon,mediamarkt,el corte ingles,carrefour,fnac,pccomponentes
